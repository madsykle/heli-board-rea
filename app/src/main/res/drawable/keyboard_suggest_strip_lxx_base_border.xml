<!--
    REA fork: the suggestion strip is part of the same iOS 27 panel as the keys.

    Upstream draws a hard 1dp line across the top of the strip here. The design has
    no such rule, so the strip reuses the panel ramp instead. The suggestion strip
    occupies the top of the keyboard, which is the light end of the design's ramp,
    so restarting the ramp here reads as the lit top edge of the panel.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
    <corners
        android:topLeftRadius="28dp"
        android:topRightRadius="28dp" />
    <gradient
        android:angle="270"
        android:startColor="#FFFFFFFF"
        android:centerColor="#FFA8A8A8"
        android:centerY="0.45"
        android:endColor="#FFDEDEDE" />
</shape>
