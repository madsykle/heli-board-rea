<!--
    REA fork: the design separates suggestions with border-right: 1px solid #ffffff18
    — a light rule at 9% opacity. Upstream drew a dark rule (#26080B0B), which is
    nearly invisible against the dark iOS 27 panel, so this is the design's value.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#18FFFFFF"/>
    <size android:width="1dp" android:height="24dp"/>
</shape>
