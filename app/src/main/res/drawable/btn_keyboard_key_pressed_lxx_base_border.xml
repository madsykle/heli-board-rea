<!--
    REA fork: iOS 27 dark pressed key.

    Flat rather than ramped, so the pressed state is a single uniform colour. The
    colour itself comes from the theme's pressed entry in the key state list, not
    from this drawable. Note the design's pressed key (#888b99) is a good deal
    lighter than HeliBoard's pressed colour, which is derived in code by brightening
    the normal key colour by a fixed small step; see PRIVACY.md / the theme README.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
    <corners android:radius="7dp" />
    <solid android:color="@android:color/white" />
</shape>
