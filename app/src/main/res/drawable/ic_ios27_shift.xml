<?xml version="1.0" encoding="utf-8"?>
<!--
    iOS 27 Dark theme only: the design's shift key (theme.tsx ShiftIcon, unshifted state).
    Source: the design's inline SVG (viewBox 0 0 28 30), ported to a 24dp vector with the
    design's aspect ratio kept. 24dp is the intrinsic size of every other keyboard icon in
    this app, and the icon is drawn at its intrinsic size, so the key's letter/icon ratio
    (keyLetterSize = 55% of the key height) is unchanged.

    Drawn in white so HeliBoard's MODULATE tint turns it into the theme's key colour, like
    every other icon. strokeLineCap/strokeLineJoin are API 24+; on 21-23 they are ignored
    and the join is a miter, which is a hair spikier but not broken.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateX="0.8">
        <path
            android:pathData="M14,2 L3.1,13.2 c-0.7,0.8 -0.2,2 1,2 h5 v9.1 c0,0.9 0.7,1.7 1.7,1.7 h6.4 c0.9,0 1.7,-0.7 1.7,-1.7 v-9.1 h5 c1.2,0 1.7,-1.3 1,-2 L14,2 Z"
            android:fillColor="@android:color/transparent"
            android:strokeColor="#FFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
