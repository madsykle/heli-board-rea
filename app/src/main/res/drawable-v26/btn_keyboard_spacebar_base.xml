<!--
    REA fork: keys use the iOS 27 design's corner radius, so the borderless spacebar
    follows (Ios27Palette.KEY_RADIUS_DP). The percentage vertical inset is upstream's, and
    is what makes the borderless spacebar read as a wide pill rather than a full height key.

    This is the API 26+ copy; there is a matching dp-based copy in drawable/. Keep
    the two in step, because drawable-v26 wins on any device this build runs on.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="25%p" android:insetBottom="25%p">
    <shape android:shape="rectangle">
        <solid android:color="@color/key_background_lxx_base" />
        <corners android:radius="7dp" />
    </shape>
</inset>
